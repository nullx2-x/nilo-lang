export func add(a: int, b: int) -> int {
    return a + b;
}

export func sum_to(n: int) -> int {
    let i: int = 0;
    let total: int = 0;
    while (i <= n) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

export func fibonacci(n: int) -> int {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}
