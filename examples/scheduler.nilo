import "std/json" as json;

type Task {
    id: str;
    title: str;
    estimate: int;
    impact: int;
    risk: int;
    deps: list<str>;
}

func task(id: str, title: str, estimate: int, impact: int, risk: int, deps: list<str>) -> Task {
    return Task(id, title, estimate, impact, risk, deps);
}

func contains(xs: list<any>, target: any) -> bool {
    for value in xs {
        if (value == target) {
            return true;
        }
    }
    return false;
}

func find_task(tasks: list<Task>, id: str) -> Task? {
    for value in tasks {
        if (value.id == id) {
            return value;
        }
    }
    return nil;
}

func deps_done(item: Task, done: list<str>) -> bool {
    for dependency in item.deps {
        if (!contains(done, dependency)) {
            return false;
        }
    }
    return true;
}

func downstream_impact(tasks: list<Task>, id: str, seen: list<str>) -> int {
    if (contains(seen, id)) {
        return 0;
    }
    push(seen, id);
    let total: int = 0;
    for item in tasks {
        if (contains(item.deps, id)) {
            total = total + item.impact;
            total = total + downstream_impact(tasks, item.id, seen);
        }
    }
    return total;
}

func score(tasks: list<Task>, item: Task) -> int {
    return item.impact * 10
        + downstream_impact(tasks, item.id, []) * 2
        - item.risk * 3
        - item.estimate;
}

func select_next(tasks: list<Task>, done: list<str>) -> Task? {
    let best: Task? = nil;
    let best_score: int = -999999;
    for item in tasks {
        if (!contains(done, item.id) && deps_done(item, done)) {
            let current_score: int = score(tasks, item);
            if (best == nil || current_score > best_score) {
                best = item;
                best_score = current_score;
            }
        }
    }
    return best;
}

func make_plan(tasks: list<Task>) -> list<Task> {
    let done: list<str> = [];
    let plan: list<Task> = [];
    while (len(done) < len(tasks)) {
        let next: Task? = select_next(tasks, done);
        if (next == nil) {
            break;
        }
        push(plan, next);
        push(done, next.id);
    }
    return plan;
}

let tasks: list<Task> = [
    task("design", "言語仕様を固める", 3, 10, 2, []),
    task("lexer", "字句解析を安定化する", 2, 8, 2, ["design"]),
    task("parser", "構文木を拡張する", 4, 9, 3, ["lexer"]),
    task("runtime", "Rust実行系を完成する", 5, 10, 3, ["parser"]),
    task("module", "import/exportを強化する", 3, 8, 2, ["parser"]),
    task("test", "回帰テストを増やす", 2, 8, 1, ["runtime", "module"]),
    task("docs", "日本語ドキュメントを整える", 2, 7, 1, ["test"]),
    task("release", "単体バイナリを公開する", 1, 10, 2, ["docs"])
];

let plan: list<Task> = make_plan(tasks);
let index: int = 0;
print("=== Nilo Task Scheduler ===");
while (index < len(plan)) {
    let item: Task = plan[index];
    print(str(index + 1) + ".", item.id, "score=" + str(score(tasks, item)));
    index = index + 1;
}
print(json.stringify({"complete": len(plan) == len(tasks), "plan": plan}, true));
