let values: list<int> = [];
for value in range(0, 10) {
    if (value == 2) {
        continue;
    }
    if (value == 6) {
        break;
    }
    push(values, value);
}
assert(values == [0, 1, 3, 4, 5], "break/continue failed");

let count: int = 0;
while (count < 3) {
    count = count + 1;
}
assert(count == 3, "while assignment failed");
